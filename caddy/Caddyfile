{
    email 753ivan@gmail.com
}

(prive_site) {
    root * /srv/site
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    # Красивые URL: /sos → sos.html
    try_files {path} {path}.html
    file_server
    handle_errors {
        @404 expression {http.error.status_code} == 404
        redir @404 / 302
    }
}

getprive.me {
    import prive_site
}

# www.getprive.me — добавить сюда redir после создания DNS-записи www

# Панель операторов (вход: HTTP Basic внутри приложения)
ops.getprive.me {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Robots-Tag "noindex, nofollow"
        -Server
    }
    reverse_proxy ops:8000
}

# Доступ по IP (пока DNS не настроен / для проверки)
:80 {
    import prive_site
}
